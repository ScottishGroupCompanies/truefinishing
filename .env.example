# Public site URL used for canonicals, Open Graph, sitemap, and RSS.
NEXT_PUBLIC_SITE_URL=https://truefinishing.com

# Optional Google Analytics 4 measurement ID. Leave unset to skip the tag.
NEXT_PUBLIC_GA_ID=

# Estimate delivery. Set a webhook, or Resend email, or both.
# No recipient is hardcoded. The form returns an error until one path is set.
LEAD_WEBHOOK_URL=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
RESEND_API_KEY=

# Optional Cloudflare Turnstile. If both are set, the form requires a token.
# If they are unset, a honeypot field is the spam check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# The job runs at 16:00 and 17:00 UTC and only republishes when it is 10:00 in Denver.
CRON_SECRET=
